[Unit]
Description=Bitcoin puzzle lottery hunter (0xzunid.muse)
After=network-online.target

[Service]
Type=simple
ExecStart=/home/hatch/workspace/bitcoin-puzzle-hunter/hunter --dir /home/hatch/workspace/bitcoin-puzzle-hunter
