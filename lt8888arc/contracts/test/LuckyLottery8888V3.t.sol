pragma solidity ^0.8.20;

import "forge-std/Test.sol";
import "../src/LuckyLottery8888V3.sol";
import "../src/LuckyLottery8888V2.sol";
import "../src/PrizePool8888.sol";
import "../src/RoyaltySplitter8888.sol";
import "../src/MintFeeSplitter8888.sol";
import "./MockSeaDropV2.sol";

/**
 * @notice V3 multiConfigure tests. The headline test replays the EXACT
 *         calldata OpenSea's publish API returned for the v2 drop
 *         (tx 0x8f010d6e..., which REVERTED on v2 because v2 has no
 *         multiConfigure) against a V3 token and proves it now
 *         succeeds and applies the draft's edits. The negative
 *         control replays the same calldata against V2 and proves
 *         it still fails there — so this test would have caught the
 *         v2 bug before mainnet.
 */
contract LuckyLottery8888V3Test is Test {
    address constant SEADROP_ARC = 0x00005EA00Ac477B1030CE78506496e8C2dE24bf5;
    address deployer = address(0xBEEF);
    string constant BASE = "https://0xzunid.github.io/0xzunid.muse.ai/lt8888arc/metadata/";
    string constant CONTRACT_URI =
        "https://0xzunid.github.io/0xzunid.muse.ai/lt8888arc/metadata/collection.json";
    // Exact publish calldata from the failed v2 publish tx 0x8f010d6e
    // (selector 0x911f456b = multiConfigure).
    bytes constant PUBLISH_DATA = hex"";

    MockSeaDropV2 seaDrop;
    PrizePool8888 pool;
    MintFeeSplitter8888 feeSplitter;
    RoyaltySplitter8888 royaltySplitter;
    LuckyLottery8888V3 token;

    function setUp() public {
        vm.deal(deployer, 1000 ether);
        // Place the mock SeaDrop's code at the real Arc SeaDrop address,
        // so the token's allowed-SeaDrop check passes and the mock
        // records the drop config the publish applies.
        MockSeaDropV2 mock = new MockSeaDropV2();
        vm.etch(SEADROP_ARC, address(mock).code);
        seaDrop = MockSeaDropV2(SEADROP_ARC);
        pool = new PrizePool8888(deployer);
        feeSplitter = new MintFeeSplitter8888(deployer, address(pool));
        royaltySplitter = new RoyaltySplitter8888(deployer, address(pool));
        address[] memory allowed = new address[](1);
        allowed[0] = SEADROP_ARC;
        token = new LuckyLottery8888V3(
            deployer, address(royaltySplitter), address(pool), BASE, CONTRACT_URI, allowed
        );
        vm.prank(deployer);
        pool.setToken(address(token));
    }

    function test_MultiConfigure_ReplaysOpenSeaPublishCalldata() public {
        vm.prank(deployer);
        (bool ok, ) = address(token).call(PUBLISH_DATA);
        assertTrue(ok, "OpenSea publish calldata must succeed on V3");
        (uint80 price, uint48 start, uint48 end, uint16 maxW, uint16 feeBps, bool restrict) =
            seaDrop.lastPublicDrop();
        assertEq(price, 88880000000000000, "mintPrice");
        assertEq(start, 1795286167, "startTime");
        assertEq(end, 1826822167, "endTime Nov 22 2027");
        assertEq(maxW, 5, "max per wallet");
        assertEq(feeBps, 1000, "feeBps");
        assertTrue(restrict, "restrictFeeRecipients");
        assertEq(
            seaDrop.creatorPayoutAddress(address(token)),
            0xA88fA0c25B43f4e5EDE99F9ffd7d5f18FDE99a03,
            "creator payout = MintFeeSplitter"
        );
        assertEq(token.baseURI(), BASE, "empty baseURI in publish leaves ours");
        assertEq(token.contractURI(), CONTRACT_URI, "empty contractURI leaves ours");
        assertEq(token.maxSupply(), 8888, "maxSupply");
    }

    function test_MultiConfigure_RevertsOnV2_NegativeControl() public {
        address[] memory allowed = new address[](1);
        allowed[0] = SEADROP_ARC;
        LuckyLottery8888V2 v2 = new LuckyLottery8888V2(
            deployer, address(royaltySplitter), address(pool), BASE, CONTRACT_URI, allowed
        );
        vm.prank(deployer);
        (bool ok, ) = address(v2).call(PUBLISH_DATA);
        assertFalse(ok, "V2 must reject the publish calldata");
    }

    function test_MultiConfigure_OnlyOwner() public {
        vm.prank(address(0xCAFE));
        (bool ok, ) = address(token).call(PUBLISH_DATA);
        assertFalse(ok, "non-owner must not multiConfigure");
    }
}
